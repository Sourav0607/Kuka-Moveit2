<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="simple_gripper" params="prefix parent *origin">

        <!-- Material definitions -->
        <material name="dark_green">
            <color rgba="0.0 0.5 0.0 1.0"/>
        </material>

        <material name="light_green">
            <color rgba="0.5 1.0 0.5 1.0"/>
        </material>

        <!-- Gripper Base Link -->
        <link name="${prefix}gripper_base_link">
            <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0.01" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            </inertial>
            <visual>
                <geometry>
                    <box size="0.2 0.06 0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
                <material name="dark_green" />
            </visual>
            <collision>
                <geometry>
                    <box size="0.2 0.06 0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
            </collision>
        </link>

        <!-- Attach gripper to parent link -->
        <joint name="${prefix}gripper_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}gripper_base_link"/>
            <xacro:insert_block name="origin"/>
        </joint>

        <!-- Left Finger Link -->
        <link name="${prefix}gripper_left_finger_link">
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0.04" rpy="0 0 0"/>
                <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
            </inertial>
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
                <material name="light_green" />
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
            </collision>
        </link>

        <!-- Right Finger Link -->
        <link name="${prefix}gripper_right_finger_link">
            <inertial>
                <mass value="0.05"/>
                <origin xyz="0 0 0.04" rpy="0 0 0"/>
                <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00001"/>
            </inertial>
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
                <material name="light_green" />
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
            </collision>
        </link>

        <!-- Left Finger Joint (prismatic) -->
        <joint name="${prefix}gripper_left_finger_joint" type="prismatic">
            <parent link="${prefix}gripper_base_link" />
            <child link="${prefix}gripper_left_finger_link" />
            <origin xyz="-0.07 0 0.02" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="100.0" velocity="0.5" lower="0.0" upper="0.06" />
        </joint>

        <!-- Right Finger Joint (prismatic, mimics left) -->
        <joint name="${prefix}gripper_right_finger_joint" type="prismatic">
            <parent link="${prefix}gripper_base_link" />
            <child link="${prefix}gripper_right_finger_link" />
            <origin xyz="0.07 0 0.02" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <limit effort="100.0" velocity="0.5" lower="-0.06" upper="0.0" />
            <mimic joint="${prefix}gripper_left_finger_joint" multiplier="-1.0" offset="0.0"/>
        </joint>

        <!-- Gazebo-specific configurations -->
        <gazebo reference="${prefix}gripper_base_link">
            <material>Gazebo/DarkGreen</material>
            <mu1>0.9</mu1>
            <mu2>0.9</mu2>
        </gazebo>

        <gazebo reference="${prefix}gripper_left_finger_link">
            <material>Gazebo/Green</material>
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo>

        <gazebo reference="${prefix}gripper_right_finger_link">
            <material>Gazebo/Green</material>
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
        </gazebo>

    </xacro:macro>

</robot>